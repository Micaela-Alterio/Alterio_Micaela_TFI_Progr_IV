@baseUrl = http://localhost:8000

### ====================================================================
### 1. CATEGORÍAS (Veggie Food Store - Catálogo Real)
### ====================================================================

### 1.1 Listar todas las Categorías (200 OK)
GET {{baseUrl}}/categorias/

### 1.2 Obtener Categoría por ID (200 OK)
GET {{baseUrl}}/categorias/1

### 1.3 Crear nueva Categoría (201 Created)
POST {{baseUrl}}/categorias/
Content-Type: application/json

{
  "nombre": "Enchiladas",
  "descripcion": "Tortillas de maíz bañadas en salsa con relleno vegetal"
}

### 1.4 Actualizar Categoría (200 OK)
PUT {{baseUrl}}/categorias/1
Content-Type: application/json

{
  "nombre": "Burritos Especiales",
  "descripcion": "Burritos tradicionales gourmet con masa artesanal"
}

### 1.5 Error 422: Crear Categoría con nombre vacío o solo espacios (RN-01)
POST {{baseUrl}}/categorias/
Content-Type: application/json

{
  "nombre": "   "
}

### 1.6 Error 404: Obtener Categoría Inexistente
GET {{baseUrl}}/categorias/9999

### 1.7 Eliminar Categoría (204 No Content)
DELETE {{baseUrl}}/categorias/1

### 1.8 Error 404: Eliminar Categoría Inexistente
DELETE {{baseUrl}}/categorias/9999


### ====================================================================
### 2. PRODUCTOS (Veggie Food Store - Catálogo Real)
### ====================================================================

### 2.1 Listar todos los Productos (200 OK)
GET {{baseUrl}}/productos/

### 2.2 Obtener Producto por ID (200 OK)
GET {{baseUrl}}/productos/1

### 2.3 Crear Producto 1 - Burrito Tex (201 Created)
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "Burrito Tex",
  "precio_base": 6000.0,
  "descripcion": "Burrito estilo TexMex de maíz, arroz, frijoles y cilantro",
  "imagenes_url": [
    "/assets/img/burrito1.jpg"
  ],
  "disponible": true
}

### 2.4 Crear Producto 4 - Chilaquiles Verdes (201 Created)
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "Chilaquiles Verdes",
  "precio_base": 15000.0,
  "descripcion": "Totopos de maíz con salsa verde, cebolla, crema, quesillo y cilantro",
  "imagenes_url": [
    "/assets/img/chilaquiles1.jpg"
  ],
  "disponible": true
}

### 2.5 Actualizar Producto por ID (200 OK)
PUT {{baseUrl}}/productos/1
Content-Type: application/json

{
  "precio_base": 6500.0,
  "disponible": true
}

### 2.6 Error 422: Validación precio_base Negativo (< 0) (RN-07)
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "Producto Inválido",
  "descripcion": "Falla por precio negativo",
  "precio_base": -100.0,
  "imagenes_url": [
    "/assets/img/burrito1.jpg"
  ],
  "disponible": true
}

### 2.7 Error 422: Validación nombre vacío o solo espacios (RN-06)
POST {{baseUrl}}/productos/
Content-Type: application/json

{
  "nombre": "   ",
  "descripcion": "Falla por nombre en blanco",
  "precio_base": 5000.0
}

### 2.8 Error 404: Obtener Producto Inexistente
GET {{baseUrl}}/productos/9999

### 2.9 Asociar Categoría 1 a Producto 1 (201 Created)
POST {{baseUrl}}/productos/1/categorias
Content-Type: application/json

{
  "categoria_id": 1
}

### 2.10 Listar Categorías de Producto 1 (200 OK)
GET {{baseUrl}}/productos/1/categorias

### 2.11 Eliminar Producto (204 No Content)
DELETE {{baseUrl}}/productos/1

### 2.12 Error 404: Eliminar Producto Inexistente
DELETE {{baseUrl}}/productos/9999
